{
  "name": "adhonep-sc-app",
  "version": "1.0.0",
  "private": true,
  "description": "App ADHONEP-SC (iOS/Android) empacotando o site com Capacitor",
  "scripts": {
    "web": "bash scripts/build-web.sh",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run web && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "android:add": "npx cap add android",
    "android:sync": "npm run web && npx cap sync android",
    "assets": "npx capacitor-assets generate --iconBackgroundColor '#102b4e' --splashBackgroundColor '#102b4e'"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0"
  }
}
